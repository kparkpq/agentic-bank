{
  "id": "dual-pending-deny",
  "description": "alice 1000000 PENDING; operator 거절 → DENIED; available unchanged; OPERATOR_DENY second audit; decision_ref stable",
  "customer_id": "syn_alice",
  "steps": [
    { "do": "session.start" },
    { "do": "handoff", "args": { "to": "transfer" } },
    {
      "do": "transfer",
      "args": {
        "from_account_id": "acc_alice_chk",
        "to_account_id": "acc_alice_sav",
        "amount": 1000000,
        "idempotency_key": "eval:dual-pending-deny:v0"
      },
      "expect": {
        "journal_status": "PENDING",
        "decision": "DUAL_CONTROL",
        "rule_id": "DUAL_AMOUNT",
        "copy_contains": "승인 대기",
        "copy_excludes": "이체 완료",
        "decision_ref_is_decide": true,
        "unapplied_entries": true,
        "blast_radius": "high"
      }
    },
    {
      "do": "operator.deny",
      "expect": {
        "journal_status": "DENIED",
        "decision": "OPERATOR_DENY",
        "copy_contains": "거절",
        "new_audit_id": true,
        "same_decision_ref": true,
        "denied_entries": true
      }
    }
  ],
  "expect_balances": {
    "acc_alice_chk": { "available": 10000000, "pending_out": 0 },
    "acc_alice_sav": { "available": 200000, "pending_out": 0 }
  }
}
