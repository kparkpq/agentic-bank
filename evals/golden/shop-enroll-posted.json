    {
      "do": "shop.enroll",
      "args": {
        "product_id": "prod_deposit_hanbit",
        "checked_documents": ["id_card", "resident_copy", "purpose_form"]
      },
      "expect": {
        "ok": true,
        "decision": "ALLOW",
        "rule_id": "ENROLL_COMPLETE",
        "copy_contains": "완료",
        "journal_status": "POSTED",
        "no_journal": true,
