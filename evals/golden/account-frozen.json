{
  "id": "account-frozen",
  "description": "freeze acc_alice_chk; 100000 DENY_POLICY ACCOUNT_FROZEN audit-only; replay eval:account-frozen:v0 reuses decide audit_id",
  "customer_id": "syn_alice",
  "fail_if": ["pending", "journal"],
  "steps": [
    { "do": "session.start" },
    { "do": "handoff", "args": { "to": "transfer" } },
    { "do": "account.freeze", "args": { "account_id": "acc_alice_chk" } },
    {
      "do": "transfer",
      "args": {
        "from_account_id": "acc_alice_chk",
        "to_account_id": "acc_alice_sav",
        "amount": 100000,
        "idempotency_key": "eval:account-frozen:v0"
      },
      "expect": {
        "decision": "DENY_POLICY",
        "rule_id": "ACCOUNT_FROZEN",
        "blast_radius": "medium",
        "ok": false,
        "no_journal": true
      }
    },
    {
      "do": "transfer",
      "args": {
        "from_account_id": "acc_alice_chk",
        "to_account_id": "acc_alice_sav",
        "amount": 100000,
        "idempotency_key": "eval:account-frozen:v0"
      },
      "expect": {
        "decision": "DENY_POLICY",
        "rule_id": "ACCOUNT_FROZEN",
        "blast_radius": "medium",
        "no_journal": true,
        "same_audit_id": true,
        "same_decision_ref": true
      }
    }
  ],
  "expect_balances": {
    "acc_alice_chk": { "available": 10000000, "pending_out": 0 },
    "acc_alice_sav": { "available": 200000, "pending_out": 0 }
  }
}
