            "POLICY_ALLOW",
            "SOURCE_ACCOUNT_NOT_OPEN",
            "DESTINATION_ACCOUNT_NOT_OPEN",
            "SENDER_OWNERSHIP_MISMATCH",
            "INSUFFICIENT_SPENDABLE_FUNDS",
            "DAILY_CAP_EXCEEDED",
            "CROSS_CUSTOMER_TRANSFER",
            "STEP_UP_REQUIRED"
