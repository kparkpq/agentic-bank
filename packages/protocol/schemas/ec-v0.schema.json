        "to_owner_customer_id": { "$ref": "#/definitions/identifier" },
        "spendable_funds": { "$ref": "#/definitions/nonNegativeInteger" },
        "daily_spent": { "$ref": "#/definitions/nonNegativeInteger" }
      }
    },
    "authorizationDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type",
        "protocol_version",
        "schema_version",
        "issuer",
        "key_id",
        "issued_at",
        "manifest_version",
        "manifest_hash",
        "trust_epoch",
        "decision_id",
        "action_hash",
        "mandate_hash",
        "policy_hash",
        "interpreter_hash",
        "snapshot_hash",
        "outcome",
        "reason_code",
        "approved_effect_hash",
        "authorized_at"
      ],
      "properties": {
        "object_type": { "const": "AuthorizationDecision" },
        "protocol_version": { "$ref": "#/definitions/protocolVersion" },
        "schema_version": { "$ref": "#/definitions/schemaVersion" },
        "issuer": { "$ref": "#/definitions/identifier" },
        "key_id": { "$ref": "#/definitions/identifier" },
