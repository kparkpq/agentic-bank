        "issuer": { "$ref": "#/definitions/identifier" },
        "key_id": { "$ref": "#/definitions/identifier" },
        "issued_at": { "$ref": "#/definitions/timestamp" },
        "manifest_version": { "$ref": "#/definitions/identifier" },
        "manifest_hash": { "$ref": "#/definitions/hash" },
        "trust_epoch": { "$ref": "#/definitions/identifier" },
        "interpreter_id": { "const": "krw-transfer-v0" },
        "interpreter_version": { "const": "1" },
        "policy_id": { "$ref": "#/definitions/identifier" },
        "policy_type": { "const": "krw-transfer-v0" },
        "supported_protocol_version": { "$ref": "#/definitions/protocolVersion" },
        "supported_schema_version": { "$ref": "#/definitions/schemaVersion" }
      }
    },
    "accountStatus": { "enum": ["OPEN", "FROZEN", "CLOSED"] },
    "decisionInputSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type",
        "protocol_version",
        "schema_version",
        "issuer",
        "key_id",
        "issued_at",
        "manifest_version",
        "manifest_hash",
        "trust_epoch",
        "snapshot_id",
        "action_hash",
        "mandate_hash",
        "policy_hash",
        "interpreter_hash",
        "from_account_status",
        "to_account_status",
        "from_owner_customer_id",
        "to_owner_customer_id",
        "spendable_funds",
        "daily_spent"
      ],
      "properties": {
        "object_type": { "const": "DecisionInputSnapshot" },
        "protocol_version": { "$ref": "#/definitions/protocolVersion" },
        "schema_version": { "$ref": "#/definitions/schemaVersion" },
        "issuer": { "$ref": "#/definitions/identifier" },
        "key_id": { "$ref": "#/definitions/identifier" },
