        "issuer": { "$ref": "#/definitions/identifier" },
        "key_id": { "$ref": "#/definitions/identifier" },
        "issued_at": { "$ref": "#/definitions/timestamp" },
        "manifest_version": { "$ref": "#/definitions/identifier" },
        "manifest_hash": { "$ref": "#/definitions/hash" },
        "trust_epoch": { "$ref": "#/definitions/identifier" },
        "action_id": { "$ref": "#/definitions/identifier" },
        "mandate_id": { "$ref": "#/definitions/identifier" },
        "customer_id": { "$ref": "#/definitions/identifier" },
        "agent_id": { "$ref": "#/definitions/identifier" },
        "transfer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from_account_id", "to_account_id", "currency", "amount"],
          "properties": {
            "from_account_id": { "$ref": "#/definitions/accountId" },
            "to_account_id": { "$ref": "#/definitions/accountId" },
            "currency": { "const": "KRW" },
            "amount": { "$ref": "#/definitions/amount" }
