{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://execution-closure.local/schemas/ec-v0.schema.json",
  "title": "Execution Closure protocol ec-v0",
  "definitions": {
    "protocolVersion": { "const": "ec-v0" },
    "schemaVersion": { "const": "1" },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "format": "ec-identifier"
    },
    "accountId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "format": "ec-account-id"
    },
    "timestamp": { "type": "string", "format": "ec-timestamp" },
    "positiveInteger": { "type": "string", "format": "ec-positive-integer" },
    "amount": { "type": "string", "format": "ec-amount" },
    "nonNegativeInteger": { "type": "string", "format": "ec-nonnegative-integer" },
    "hash": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "publicKey": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_-]+$" },
    "signatureBytes": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" },
    "authorityRole": {
      "enum": [
        "trust_root",
        "mandate_authority",
        "action_proposer",
        "policy_authority",
        "interpreter_authority",
        "snapshot_authority",
        "decision_authority",
        "capsule_authority",
        "executor",
        "ledger",
        "closure_authority"
      ]
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "issuer", "key_id", "algorithm", "signature"],
      "properties": {
        "role": { "$ref": "#/definitions/authorityRole" },
        "issuer": { "$ref": "#/definitions/identifier" },
        "key_id": { "$ref": "#/definitions/identifier" },
        "algorithm": { "const": "Ed25519" },
        "signature": { "$ref": "#/definitions/signatureBytes" }
      }
    },
    "signedEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body", "signatures"],
      "properties": {
        "body": { "type": "object" },
        "signatures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/definitions/signature" }
        }
      }
    },
    "authorityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "issuer", "key_id", "algorithm", "public_key"],
      "properties": {
        "role": { "$ref": "#/definitions/authorityRole" },
        "issuer": { "$ref": "#/definitions/identifier" },
        "key_id": { "$ref": "#/definitions/identifier" },
        "algorithm": { "const": "Ed25519" },
        "public_key": { "$ref": "#/definitions/publicKey" }
      }
    },
    "trustedRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "issuer", "key_id", "algorithm", "public_key"],
      "properties": {
        "role": { "const": "trust_root" },
        "issuer": { "$ref": "#/definitions/identifier" },
        "key_id": { "$ref": "#/definitions/identifier" },
        "algorithm": { "const": "Ed25519" },
        "public_key": { "$ref": "#/definitions/publicKey" }
      }
    },
    "pinFields": {
      "type": "object",
      "required": [
        "protocol_version",
        "schema_version",
        "issuer",
        "key_id",
        "issued_at",
        "manifest_version",
        "manifest_hash",
        "trust_epoch"
      ],
      "properties": {
        "protocol_version": { "$ref": "#/definitions/protocolVersion" },
        "schema_version": { "$ref": "#/definitions/schemaVersion" },
        "issuer": { "$ref": "#/definitions/identifier" },
        "key_id": { "$ref": "#/definitions/identifier" },
        "issued_at": { "$ref": "#/definitions/timestamp" },
        "manifest_version": { "$ref": "#/definitions/identifier" },
        "manifest_hash": { "$ref": "#/definitions/hash" },
        "trust_epoch": { "$ref": "#/definitions/identifier" }
      }
    },
    "trustRootManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type",
        "protocol_version",
        "schema_version",
        "issuer",
        "key_id",
        "issued_at",
        "manifest_version",
        "trust_epoch",
        "assurance_profile",
        "authorities",
        "supported_policy_ids",
        "supported_interpreter_ids"
      ],
      "properties": {
        "object_type": { "const": "TrustRootManifest" },
        "protocol_version": { "$ref": "#/definitions/protocolVersion" },
        "schema_version": { "$ref": "#/definitions/schemaVersion" },
        "issuer": { "$ref": "#/definitions/identifier" },
        "key_id": { "$ref": "#/definitions/identifier" },
        "issued_at": { "$ref": "#/definitions/timestamp" },
        "manifest_version": { "$ref": "#/definitions/identifier" },
        "trust_epoch": { "$ref": "#/definitions/identifier" },
        "assurance_profile": { "const": "single_process_simulation" },
        "authorities": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": { "$ref": "#/definitions/authorityBinding" }
        },
        "supported_policy_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/identifier" }
        },
        "supported_interpreter_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/identifier" }
        }
      }
    },
    "trustStore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type",
        "protocol_version",
        "schema_version",
        "expected_assurance_profile",
        "manifest_version",
        "manifest_hash",
        "trust_epoch",
        "trusted_roots"
      ],
      "properties": {
        "object_type": { "const": "TrustStore" },
        "protocol_version": { "$ref": "#/definitions/protocolVersion" },
        "schema_version": { "$ref": "#/definitions/schemaVersion" },
        "expected_assurance_profile": { "const": "single_process_simulation" },
        "manifest_version": { "$ref": "#/definitions/identifier" },
        "manifest_hash": { "$ref": "#/definitions/hash" },
        "trust_epoch": { "$ref": "#/definitions/identifier" },
        "trusted_roots": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/trustedRoot" }
        }
      }
    },
    "mandate": {
      "allOf": [
        { "$ref": "#/definitions/pinFields" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "object_type",
            "protocol_version",
            "schema_version",
            "issuer",
            "key_id",
            "issued_at",
            "manifest_version",
            "manifest_hash",
            "trust_epoch",
            "mandate_id",
            "customer_id",
            "agent_id",
            "from_account_id",
            "to_account_id",
            "currency",
            "max_amount",
            "not_before",
            "expires_at"
          ],
          "properties": {
            "object_type": { "const": "Mandate" },
            "protocol_version": { "$ref": "#/definitions/protocolVersion" },
            "schema_version": { "$ref": "#/definitions/schemaVersion" },
            "issuer": { "$ref": "#/definitions/identifier" },
            "key_id": { "$ref": "#/definitions/identifier" },
            "issued_at": { "$ref": "#/definitions/timestamp" },
            "manifest_version": { "$ref": "#/definitions/identifier" },
            "manifest_hash": { "$ref": "#/definitions/hash" },
            "trust_epoch": { "$ref": "#/definitions/identifier" },
            "mandate_id": { "$ref": "#/definitions/identifier" },
            "customer_id": { "$ref": "#/definitions/identifier" },
            "agent_id": { "$ref": "#/definitions/identifier" },
            "from_account_id": { "$ref": "#/definitions/accountId" },
            "to_account_id": { "$ref": "#/definitions/accountId" },
            "currency": { "const": "KRW" },
            "max_amount": { "$ref": "#/definitions/amount" },
            "not_before": { "$ref": "#/definitions/timestamp" },
            "expires_at": { "$ref": "#/definitions/timestamp" }
          }
        }
      ]
    },
    "proposedAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type",
        "protocol_version",
        "schema_version",
        "issuer",
        "key_id",
        "issued_at",
        "manifest_version",
        "manifest_hash",
        "trust_epoch",
        "action_id",
        "mandate_id",
