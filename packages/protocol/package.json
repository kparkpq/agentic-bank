{
  "name": "@execution-closure/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts",
    "./schemas/ec-v0.schema.json": "./schemas/ec-v0.schema.json",
    "./testing": "./src/testing.ts"
  },
  "bin": {
    "execution-closure-verify": "./bin/execution-closure-verify.mjs"
  },
  "files": [
    "bin",
    "fixtures",
    "release-manifest.json",
    "schemas",
    "src",
    "package.json"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "node --import tsx bin/execution-closure-verify.mjs"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "canonicalize": "4.0.0",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
